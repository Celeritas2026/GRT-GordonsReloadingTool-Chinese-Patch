    <appendix>
      <note index="1" hasfocus="false" showinreport="false" reporttemplate="false" title="Load%20Data%20Notes" text="Based%20on%20Gordons%20preliminary%20IMR%204166%20%282020-03-02%29%20powder%20file%20model%2C%20ran%20this%20series%20in%20my%206.5%20CM.%0DBased%20on%20visual%20pressure%20signs%2C%20I%20would%20say%20the%20max%20charge%20tested%20here%20was%20approx.%2059000%20psi%20as%20there%20are%20no%20firing%20pin%20cratering%2C%0Dand%20no%20bolt%20rotational%20scrape%20marks.%20%20Bolt%20lift%20was%20very%20easy%20at%20the%20max%20charge.%20%20%0DNeck%20seal%20at%20the%20min%20charge%20was%20perfect%2C%20no%20soot%20at%20all%20even%20on%20the%20neck.%0DIMR%204166%20%282020-03-02%29%20model%20is%20within%2024%20fps%20of%20the%20actual%20fired%20velocity%20at%20the%20top%20charge%2C%20and%20within%2034%20fps%20at%20the%20lowest%20charge.%0DIt%20looks%20like%20with%20these%20cases%20the%20max%20charge%20could%20go%20to%2038.8%20gr.%0DRemaining%20soot%20in%20the%20case%20is%20medium%20grey%20with%20no%20signs%20of%20unburnt%20powder.%0DNo%20PTII%20data%20available%20for%20this%20cartridge.%0DThere%20is%20still%20room%20for%20more%20powder%20as%20the%20bullet%20is%20not%20compressing%20the%20charge.%0DAfter%20firing%20I%20would%20say%20the%2038.8%20charge%20is%20the%20absolute%20max%20for%20this%20setup.%0DThe%20simulation%20velocity%20leads%20actual%20firing%20results%20a%20little.%20%20The%20lead%20is%20greater%20as%20the%20charge%20is%20reduced.%0D%20%20" selstart="0" sellength="0" scrollposition="0" config="%7Bfeatures%2C1%2C1%2C0%2Cnoname.txt%2C%2C%3B%3A%3C%3E%28%29%5B%5D%7B%7D%22%22%27%C2%B4%60%7C%5E%C2%B0%3D%7E%2C1%2C1%2C0%2C1%2C1%2C1%2C1%2C%250D%2C%2C0%2C1%2C1000%2C-1%2C0%2C1%2C1%2C1%2C4%2C1%2C9%2C0%2C0%2C0%2C0%2C1%2C0%2C4%7D%2C%7Bstyle%2C%7D%2C%7Bedit%2C84%2C1%2C-1%2C-1%2C-1%2C-1%2C0%2C0%7D" />
