      <note index="3" hasfocus="false" showinreport="false" reporttemplate="false" title="Note%20to%20Gordon" text="I%20would%20say%20the%20%20GRT%20results%20%20are%20spot%20on%20for%20the%20%20max%20charge%2C%20but%20lags%20behind%20%20reality%20%20at%20the%20lowest%20charge%20of%20powder.%0DIf%20the%20Initial%20Pressure%20is%20raised%20to%20about%204200%20psi%20the%20max%20charge%20simulation%20results%20are%20almost%20perfect.%0DThis%20holds%20true%20for%20both%20bullet%20weights%20in%2030-06.%0DI%20would%20say%20combustion%20is%20very%20close%20to%20100%25." selstart="0" sellength="0" scrollposition="0" config="%7Bfeatures%2C1%2C1%2C0%2Cnoname.txt%2C%2C%3B%3A%3C%3E%28%29%5B%5D%7B%7D%22%22%27%C2%B4%60%7C%5E%C2%B0%3D%7E%2C1%2C1%2C0%2C1%2C1%2C1%2C1%2C%250D%2C%2C0%2C1%2C1000%2C-1%2C0%2C1%2C1%2C1%2C4%2C1%2C10%2C0%2C0%2C0%2C0%2C1%2C0%2C4%7D%2C%7Bstyle%2C%7D%2C%7Bedit%2C45%2C3%2C49%2C-1%2C2%2C-1%2C0%2C0%7D" />
